---
import ListPage from '../../../components/ListPage.astro';
import { SITE } from '../../../config/site';
import { allArticles } from '../../../lib/content';
export async function getStaticPaths() {
  const n = Math.ceil((await allArticles()).length / SITE.pageSize);
  return Array.from({ length: n - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const p = Number(Astro.params.page);
const list = await allArticles();
---
<ListPage page={p} pages={Math.ceil(list.length / SITE.pageSize)} items={list.slice((p - 1) * SITE.pageSize, p * SITE.pageSize)} />
