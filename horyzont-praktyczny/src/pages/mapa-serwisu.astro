---
import Shell from '../layouts/Shell.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE, TOPICS, INFO_LINKS } from '../config/site';
import { allArticles, href } from '../lib/content';
const list = await allArticles();
---
<Shell title={`Mapa serwisu – ${SITE.name}`} description={`Wszystkie podstrony portalu ${SITE.name}: tematy, publikacje i strony informacyjne w jednym miejscu.`}>
  <div class="wrap page">
    <Crumbs trail={[{ name: 'Mapa serwisu' }]} />
    <h1 class="page__title">Mapa serwisu</h1>
    <div class="topic-index">
      {TOPICS.map((t) => <section class="topic-index__item" style={`--t:${t.color}`}><h2><a href={`/temat/${t.slug}/`}>{t.name}</a></h2><ul>{list.filter((e) => e.data.topic === t.slug).map((e) => <li><a href={href(e)}>{e.data.title}</a></li>)}</ul></section>)}
      <section class="topic-index__item"><h2>Serwis</h2><ul><li><a href="/publikacje/">Wszystkie publikacje</a></li><li><a href="/temat/">Tematy</a></li>{INFO_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></section>
    </div>
  </div>
</Shell>
