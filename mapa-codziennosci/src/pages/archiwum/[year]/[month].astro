---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleList from '../../../components/ArticleList.astro';
import { SITE } from '../../../config/site';
import { getArticles, monthKey, MONTHS_PL, type Article } from '../../../lib/articles';

export async function getStaticPaths() {
  const all = await getArticles();
  const groups = new Map<string, Article[]>();
  for (const a of all) {
    const { y, m } = monthKey(a.data.date);
    const k = `${y}/${m}`;
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k)!.push(a);
  }
  return [...groups.entries()].map(([k, articles]) => {
    const [year, month] = k.split('/');
    return { params: { year, month }, props: { articles } };
  });
}
const { year, month } = Astro.params;
const { articles } = Astro.props as { articles: Article[] };
const label = `${MONTHS_PL[Number(month) - 1]} ${year}`;
---
<BaseLayout title={`Archiwum: ${label} | ${SITE.name}`} description={`Artykuły opublikowane w magazynie ${SITE.name} w miesiącu ${label} – ${articles.length} poradników i tekstów z ośmiu działów.`}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Archiwum', href: '/archiwum/' }, { label }]} />
    <header class="page-head">
      <p class="section-head__kicker">Archiwum miesięczne</p>
      <h1 class="page-head__title">{label.charAt(0).toUpperCase() + label.slice(1)}</h1>
      <p class="page-head__lead">Liczba publikacji w tym miesiącu: {articles.length}.</p>
    </header>
    <ArticleList articles={articles} />
    <p><a class="button button--ghost" href="/archiwum/">← Pełne archiwum</a></p>
  </div>
</BaseLayout>
