---
import Page from '../../layouts/Page.astro';
import Crumbs from '../../components/Crumbs.astro';
import Story from '../../components/Story.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { PORTAL, REGIONS, regionOf } from '../../config/portal';
import { stories } from '../../lib/news';
export const getStaticPaths = () => REGIONS.map((r) => ({ params: { slug: r.slug } }));
const r = regionOf(Astro.params.slug!);
const items = (await stories()).filter((s) => s.data.region === r.slug);
---
<Page title={`Wydanie regionalne: ${r.label} | ${PORTAL.name}`} description={`${r.intro} Wszystkie publikacje portalu ${PORTAL.name} oznaczone regionem ${r.label}.`} active={`region:${r.slug}`}>
  <div class="frame">
    <Crumbs path={[{ name: `Region: ${r.label}` }]} />
    <header class="desk-head desk-head--region"><h1>Wydanie regionalne: {r.label}</h1><p>{r.intro}</p><p class="desk-head__count">{items.length} publikacji</p></header>
    {items[0] && <div class="desk-lead"><Story story={items[0]} shape="lead" h="h2" showRegion={false} eager /></div>}
    <StoryGrid items={items.slice(1)} />
    <nav class="other-desks" aria-label="Inne regiony"><h2 class="label-bar label-bar--dark">Inne wydania</h2><ul>{REGIONS.filter((x) => x.slug !== r.slug).map((x) => <li><a href={`/region/${x.slug}/`}>{x.label}</a></li>)}</ul></nav>
  </div>
</Page>
