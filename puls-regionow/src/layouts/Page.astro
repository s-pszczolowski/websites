---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/oswald/wght.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/puls.css';
import { PORTAL } from '../config/portal';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import Ld from '../components/Ld.astro';
interface Props { title: string; description: string; image?: string; kind?: 'website' | 'article'; noindex?: boolean; ld?: object[]; active?: string; articleMeta?: { published: string; modified: string; section: string } }
const { title, description, image = '/grafika/udostepnianie/portal.jpg', kind = 'website', noindex = false, ld = [], active, articleMeta } = Astro.props;
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const home = new URL('/', site).href;
const img = new URL(image, site).href;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#B33434" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/grafika/logo.png" />
  <link rel="alternate" type="application/rss+xml" title={PORTAL.name} href="/rss.xml" />
  <meta property="og:site_name" content={PORTAL.name} />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:type" content={kind} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={img} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {articleMeta && <><meta property="article:published_time" content={articleMeta.published} /><meta property="article:modified_time" content={articleMeta.modified} /><meta property="article:section" content={articleMeta.section} /></>}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={img} />
  <Ld json={[
    { '@context': 'https://schema.org', '@type': 'NewsMediaOrganization', '@id': `${home}#redakcja`, name: PORTAL.name, url: home, slogan: PORTAL.motto, areaServed: 'Polska', logo: { '@type': 'ImageObject', url: new URL('/grafika/logo.png', site).href, width: 512, height: 512 } },
    { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${home}#portal`, name: PORTAL.name, url: home, inLanguage: 'pl-PL', description: PORTAL.about, publisher: { '@id': `${home}#redakcja` } },
    ...ld,
  ]} />
</head>
<body>
  <a class="jump" href="#tresc">Przejdź do treści</a>
  <Masthead active={active} />
  <main id="tresc"><slot /></main>
  <Footer />
</body>
</html>
