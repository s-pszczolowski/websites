---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/manrope';
import '../styles/magazyn.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { MAGAZINE } from '../config/magazine';

interface Props {
  title: string; description: string; image?: string; imageAlt?: string; type?: 'website' | 'article';
  noindex?: boolean; current?: string; ld?: object[]; article?: { published: string; modified: string; section: string };
}
const { title, description, image = '/obrazy/udostepnij/magazyn.jpg', imageAlt = MAGAZINE.name, type = 'website', noindex = false, current, ld = [], article } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const org = { '@context': 'https://schema.org', '@type': 'Organization', '@id': new URL('/#wydawca', site).href, name: MAGAZINE.name, url: new URL('/', site).href, logo: { '@type': 'ImageObject', url: new URL('/obrazy/logo.png', site).href, width: 512, height: 512 }, slogan: MAGAZINE.tagline };
const web = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#magazyn', site).href, name: MAGAZINE.name, url: new URL('/', site).href, inLanguage: 'pl-PL', description: MAGAZINE.description, publisher: { '@id': org['@id'] } };
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#FAF8F5" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={MAGAZINE.name} href="/rss.xml" />
  <meta property="og:site_name" content={MAGAZINE.name} />
  <meta property="og:locale" content={MAGAZINE.locale} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article && <meta property="article:modified_time" content={article.modified} />}
  {article && <meta property="article:section" content={article.section} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <JsonLd data={[org, web, ...ld]} />
</head>
<body>
  <Header current={current} />
  <main id="tresc">
    <slot />
  </main>
  <Footer />
</body>
</html>
